# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SYSTEM & PLATFORM IDENTIFICATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Chipset identification
ro.soc.manufacturer=QTI

# Factory Reset Protection partition
ro.frp.pst=/dev/block/bootdevice/by-name/frp

# Netflix certification revision
ro.netflix.bsp_rev=Q8450-34634-1

# Zygote critical stability window
zygote.critical_window.minute=10

# Incremental filesystem support
ro.incremental.enable=yes


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DISPLAY & GRAPHICS SUBSYSTEM
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── SurfaceFlinger Core Configuration ──────────────────────────────────────────
debug.sf.latch_unsignaled=1
debug.sf.enable_transaction_tracing=false
debug.sf.disable_client_composition_cache=1
debug.egl.swapinterval=1
debug.egl.profiler=0
persist.vendor.qcom.adreno.disable_ubwc=0
persist.vendor.qcom.adreno.idle_time=35
debug.sf.enable_advanced_sf_phase_offset=1
debug.sf.enable_gl_backpressure=0
debug.sf.disable_backpressure=1
debug.sf.predict_hwc_composition_strategy=0
debug.sf.high_fps_early_gl_phase_offset_ns=-2000000
debug.sf.high_fps_early_phase_offset_ns=-4000000
debug.sf.high_fps_late_app_phase_offset_ns=1000000
debug.sf.high_fps_late_sf_phase_offset_ns=-2000000
debug.sf.treat_170m_as_sRGB=1

# ── Display Capabilities & HDR ─────────────────────────────────────────────────
ro.surface_flinger.use_smart_90_for_video=true
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.has_wide_color_display=true
ro.surface_flinger.has_HDR_display=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.protected_contents=true
ro.surface_flinger.use_color_management=true
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.wcg_composition_dataspace=143261696
debug.sf.enable_linear_color=true
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.supports_background_blur=1
ro.surface_flinger.enable_frame_rate_override=true

# ── Vendor Display Features (120Hz Optimization) ───────────────────────────────
vendor.display.comp_mask=0
vendor.display.disable_3d_adaptive_tm=1
vendor.display.disable_content_fps_hint=0
vendor.display.disable_excl_rect=0
vendor.display.disable_excl_rect_partial_fb=1
vendor.display.disable_noise_layer=1
vendor.display.disable_scaler=0
vendor.display.disable_sdr_dimming=1
vendor.display.disable_sdr_histogram=1
vendor.display.disable_stc_dimming=1
vendor.display.enable_async_powermode=0
vendor.display.enable_async_vds_creation=1
vendor.display.enable_dpps_dynamic_fps=1
vendor.display.enable_early_wakeup=1
vendor.display.enable_hdr10_gpu_target=1
vendor.display.enable_optimize_refresh=1
vendor.display.enable_rounded_corner=1
vendor.display.use_layer_ext=1
vendor.display.use_smooth_motion=1
vendor.display.vds_allow_hwc=1
vendor.display.enable_rotator_ui=1
vendor.gralloc.disable_ubwc=0

# ── Touch Input ────────────────────────────────────────────────────────────────
ro.input.noresample=1
touch.pressure.scale=0.001

# ── Graphics Hardware Abstraction ──────────────────────────────────────────────
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false
ro.hardware.egl=adreno
ro.hardware.vulkan=adreno
ro.opengles.version=196610

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# HWUI RENDERING OPTIMIZATIONS (VULKAN)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Core rendering parameters
ro.hwui.render_ahead=1
debug.hwui.use_hint_manager=true
debug.hwui.skia_atrace_enabled=false
debug.hwui.render_thread_priority=1

# 🔥 Enable Vulkan
debug.hwui.use_vulkan=true
debug.hwui.renderer=skiavk

# Keep vsync enabled (never disable on modern devices)
debug.hwui.disable_vsync=false

# Overdraw debug OFF (production builds)
debug.hwui.overdraw=false

# Vulkan optimization flags
renderthread.skia.reduceopstasksplitting=true
debug.hwui.skip_empty_damage=true

# ── Cache Configuration (Adreno 730 tuned) ─────────────────────────────────────
ro.hwui.drop_shadow_cache_size=8
ro.hwui.gradient_cache_size=4
ro.hwui.layer_cache_size=48
ro.hwui.path_cache_size=32
ro.hwui.texture_cache_size=96

# Text atlas (leave as-is; Vulkan handles large atlas fine)
ro.hwui.text_small_cache_width=2048
ro.hwui.text_small_cache_height=2048
ro.hwui.text_large_cache_width=4096
ro.hwui.text_large_cache_height=4096


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
