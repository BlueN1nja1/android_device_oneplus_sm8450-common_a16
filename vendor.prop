vendor.vidc.dec.enable.downscalar=0
vendor.vidc.enc.disable.pq=true


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 13. PERFORMANCE & SCROLL OPTIMIZATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Scroll / Fling Physics ────────────────────────────────────────────────────
ro.min.fling_velocity=160
ro.max.fling_velocity=20000

# ── QTI Performance Services ──────────────────────────────────────────────────
ro.vendor.extension_library=libqti-perfd-client.so
vendor.pasr.activemode.enabled=false
vendor.pasr.enabled=false
vendor.perf.framepacing.enable=1
ro.vendor.perf.scroll_opt=true
ro.vendor.qti.cgroup_follow.enable=true
ro.vendor.qti.sys.fw.bservice_enable=true
ro.vendor.qti.sys.fw.bservice_age=5000
ro.vendor.qti.sys.fw.bservice_limit=10
persist.vendor.powerhal.interaction.enable=true
persist.vendor.powerhal.interaction.duration=30
persist.vendor.powerhal.interaction.max=1


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 14. SECURITY & DRM
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
drm.service.enabled=true
vendor.gatekeeper.disable_spu=true


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 15. FILESYSTEM & STORAGE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
persist.sys.fuse.passthrough.enable=true


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 16. DEVICE POWER MANAGEMENT (DPM)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
persist.vendor.dpm.vndr.feature=11
persist.vendor.dpm.vndr.halservice.enable=1
persist.vendor.dpm.vndr.idletimer.mode=default


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 17. FINGERPRINT (GOODIX UDFPS)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ── Core HAL (Accuracy > Speed) ───────────────────────────────────────────────
persist.vendor.goodix.fp.wakeup=true
persist.vendor.goodix.fp.retry_enable=1
persist.vendor.goodix.fp.match_timeout=999
persist.vendor.goodix.fp.enroll_timeout=999
persist.vendor.goodix.fp.partial_allow=1

# ── Optical UDFPS ─────────────────────────────────────────────────────────────
persist.vendor.goodix.udfps.enable=true

# ── Debug (Disabled for Best Accuracy) ────────────────────────────────────────
persist.vendor.goodix.fp.debug=0
persist.vendor.udfps.debug=0


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 18. SYSTEM IDENTIFICATION & VENDOR PROPERTIES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
ro.vendor.qti.va_aosp.support=1

# ── IMS Logging Control ──────────────────────────────────────────────────────
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1


# =========================================================
# MEMORY / ACTIVITY MANAGER (SM8450 OPTIMIZED)
# =========================================================
ro.sys.fw.bg_apps_limit=16
