debug.sf.enable_adpf_cpu_hint=true
debug.hwui.use_hint_manager=true
debug.hwui.skia_atrace_enabled=false
debug.hwui.render_thread_priority=1
debug.hwui.use_vulkan=true
debug.hwui.renderer=skiavk
debug.hwui.disable_vsync=false
debug.hwui.overdraw=false
renderthread.skia.reduceopstasksplitting=true
debug.hwui.skip_empty_damage=true
debug.hwui.skia_tracing_enabled=false
debug.hwui.skia_use_perfetto_track_events=false
debug.hwui.target_cpu_time_percent=40

# ── Cache Configuration (Adreno 730) ──────────────────────────────────────────
ro.hwui.drop_shadow_cache_size=8
ro.hwui.gradient_cache_size=4
ro.hwui.layer_cache_size=64
ro.hwui.path_cache_size=32
ro.hwui.texture_cache_size=128
ro.hwui.text_small_cache_width=2048
ro.hwui.text_small_cache_height=2048
ro.hwui.text_large_cache_width=4096
ro.hwui.text_large_cache_height=4096


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
