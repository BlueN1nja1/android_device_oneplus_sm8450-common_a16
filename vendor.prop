# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# MEMORY MANAGEMENT & LOW MEMORY KILLER
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Dalvik heap configuration
dalvik.vm.heapstartsize=16m
dalvik.vm.heapgrowthlimit=256m
dalvik.vm.heapsize=512m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=2m
dalvik.vm.heapmaxfree=8m

# Background app limits & ZRAM tuning
ro.sys.fw.bg_apps_limit=28
ro.zram.mark_idle_delay_mins=60
ro.zram.first_wb_delay_mins=1440
ro.zram.periodic_wb_delay_hours=24


# Asset management
persist.sys.purgeable_assets=1


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEX OPTIMIZATION & ART RUNTIME
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

dalvik.vm.systemservercompilerfilter=speed
dalvik.vm.dex2oat-flags=--no-watch-dog
dalvik.vm.image-dex2oat-filter=speed
dalvik.vm.dex2oat-filter=speed
dalvik.vm.minidebuginfo=false
dalvik.vm.dex2oat-minidebuginfo=false
dalvik.vm.dex2oat64.enabled=true
dalvik.vm.usejitprofiles=true
dalvik.vm.jitprofile_saver=true


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# PERFORMANCE & SCROLL OPTIMIZATION
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Scroll/fling physics
ro.min.fling_velocity=160
ro.max.fling_velocity=20000

# QTI performance services
ro.vendor.qti.sys.fw.bservice_enable=true
ro.vendor.qti.sys.fw.bservice_limit=10
ro.vendor.qti.sys.fw.bservice_age=5000
ro.vendor.perf.scroll_opt=true
ro.vendor.qti.cgroup_follow.enable=true
ro.vendor.extension_library=libqti-perfd-client.so


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SECURITY & DRM
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

drm.service.enabled=true
vendor.gatekeeper.disable_spu=true


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# FILESYSTEM & STORAGE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

persist.sys.fuse.passthrough.enable=true


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DEVICE POWER MANAGEMENT (DPM)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

persist.vendor.dpm.vndr.feature=11
persist.vendor.dpm.vndr.halservice.enable=1
persist.vendor.dpm.vndr.idletimer.mode=default
#persist.vendor.dpm.vndr.tcm=2

# ------------------------------------------------------------------------------
# Core Goodix Fingerprint HAL (Accuracy > Speed)
# ------------------------------------------------------------------------------

persist.vendor.goodix.fp.wakeup=true
persist.vendor.goodix.fp.retry_enable=1           # must be enabled
persist.vendor.goodix.fp.match_timeout=999        # increase timeout to allow multiple retries
persist.vendor.goodix.fp.enroll_timeout=999       # optional, allows longer enrollment
persist.vendor.goodix.fp.partial_allow=1

# ------------------------------------------------------------------------------
# Optical UDFPS Image Quality (MOST IMPORTANT)
# ------------------------------------------------------------------------------

persist.vendor.goodix.udfps.enable=true

# ------------------------------------------------------------------------------
# AOD / Screen-Off Accuracy (Doze Reliability)
# ------------------------------------------------------------------------------

persist.vendor.goodix.fp.aod_enable=1

# ------------------------------------------------------------------------------
# Debug (Keep Disabled for Best Accuracy)
# ------------------------------------------------------------------------------

persist.vendor.goodix.fp.debug=0
persist.vendor.udfps.debug=0

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# SYSTEM IDENTIFICATION & VENDOR PROPERTIES
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

ro.vendor.qti.va_aosp.support=1

# ── IMS Logging Control ────────────────────────────────────────────────────────
persist.vendor.ims.disableADBLogs=1
persist.vendor.ims.disableDebugLogs=1
persist.vendor.ims.disableIMSLogs=1
persist.vendor.ims.disableQXDMLogs=1

vendor.mm.enable.qcom_parser=4044018

# Disable voice AGC / automatic gain
vendor.audio.feature.incall_agc.disable=true
persist.vendor.audio.feature.ns.enable=true